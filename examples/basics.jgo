// このファイルは単独のプログラムです。文法は仮案です。
パッケージ main

読み込む "fmt"

定数 合格点 = 60

型 利用者 構造体 {
	名前 string
}

型 挨拶できる インターフェース {
	挨拶() string
}

関数 (人 利用者) 挨拶() string {
	返す "こんにちは、" + 人.名前
}

関数 判定(点数 int) string {
	もし 点数 >= 80 {
		返す "優秀"
	} それ以外 もし 点数 >= 合格点 {
		返す "合格"
	} それ以外 {
		返す "不合格"
	}
}

関数 main() {
	変数 合計 int
	点数一覧 := []int{50, 65, 80}
	繰り返し _, 点数 := 列挙 点数一覧 {
		合計 += 点数
		fmt.Println(点数, 判定(点数))
	}
	fmt.Println("合計:", 合計)

	繰り返し i := 0; i < 5; i++ {
		もし i == 1 {
			繰り返しを続ける
		}
		もし i == 3 {
			抜ける
		}
		fmt.Println("番号:", i)
	}

	残り := 2
	繰り返し 残り > 0 {
		残り--
	}

	得点表 := マップ[string]int{"太郎": 80}
	分岐 得点表["太郎"] {
	場合 80, 90, 100:
		fmt.Println("高得点")
	既定:
		fmt.Println("確認しよう")
	}

	変数 挨拶役 挨拶できる = 利用者{名前: "太郎"}
	fmt.Println(挨拶役.挨拶())
}
