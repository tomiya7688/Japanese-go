// Japanese-go v0.2の自然な文型。変換器はまだ未実装です。
パッケージ main

"fmt" を 読み込む

関数 判定(点数 int) string {
    もし 点数 >= 80 ならば {
        "優秀" を 返す
    } それ以外 もし 点数 >= 60 ならば {
        "合格" を 返す
    } それ以外 {
        "不合格" を 返す
    }
}

関数 main() {
    関数の終わりに fmt.Println("終了")

    // 0, 1, 2, 3。終点も含む。
    繰り返し i が 0 から 3 まで {
        fmt.Println("番号:", i)
    }

    点数一覧 := []int{50, 65, 80}
    点数一覧 から _, 点数 を 列挙して 繰り返し {
        fmt.Println(点数, 判定(点数))
    }

    判定(80) で 分岐 {
        "優秀" の場合:
            fmt.Println("高得点")
        それ以外の場合:
            fmt.Println("次回もがんばろう")
    }

    回数 := 0
    回数 < 2 の間 繰り返し {
        回数++
    }
    fmt.Println("回数:", 回数)
}
