// このファイルは単独のプログラムです。文法は仮案です。
パッケージ main

読み込む "fmt"

関数 送る(宛先 チャネル<- string) {
	関数の終わりに close(宛先)
	宛先 <- "別のgoroutineからこんにちは"
}

関数 main() {
	関数の終わりに fmt.Println("受信を終了")
	受信箱 := make(チャネル string)
	行け 送る(受信箱)

	繰り返し {
		選ぶ {
		場合 メッセージ, 開いている := <-受信箱:
			もし !開いている {
				返す
			}
			fmt.Println(メッセージ)
		}
	}
}
