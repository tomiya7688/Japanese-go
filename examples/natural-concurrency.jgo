// Japanese-go v0.2の並行処理とselect。変換器の受け入れサンプルです。
パッケージ main

"fmt" を 読み込む

関数 送る(宛先 チャネル<- string) {
    関数の終わりに close(宛先)
    宛先 <- "こんにちは"
}

関数 main() {
    受信箱 := make(チャネル string)
    送る(受信箱) を 並行で実行する

    繰り返し {
        通信を選ぶ {
            メッセージ, 開いている := <-受信箱 の場合:
                もし !開いている ならば {
                    返す
                }
                fmt.Println(メッセージ)
        }
    }
}
